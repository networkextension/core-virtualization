From 30a6c9b4b0ef55986493c614563b038403c2e57a Mon Sep 17 00:00:00 2001
From: XiangBo Kong <yarshure@gmail.com>
Date: Tue, 27 Oct 2026 13:56:13 +0000
Subject: [PATCH] arm64: detect the GIC version from GICD_PIDR2 when the MADT
 omits it

Apple's Virtualization.framework presents an arm64 guest via ACPI (no
FDT) whose MADT GIC Distributor subtable reports Version 0
(ACPI_MADT_GIC_VERSION_NONE) rather than 3.  gic_v3_acpi_identify()
only accepts Version 3 and 4, so the GICv3 driver never attaches, the
generic timer has no interrupt parent, and the kernel panics with "No
usable event timer found!".  The GICv2 ACPI driver, meanwhile, accepts
Version 0 and adds a child for what is really a GICv3 distributor.

Add gic_acpi_dist_version(), used by both ACPI drivers.  It returns the
MADT version when one is given.  When it is unspecified and the MADT
describes GICv3 redistributors (a GICR structure, or a GICC with a GICR
base address), it reads the architecture version from GICD_PIDR2, as
Linux does.  Such a distributor is now claimed by the GICv3 driver
only.  A GICv2 system that leaves the version unspecified has no
redistributors and keeps the previous behaviour; its distributor is not
read beyond the GICv2 frame.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: XiangBo Kong <yarshure@gmail.com>
---
 sys/arm/arm/gic_acpi.c        | 77 ++++++++++++++++++++++++++++++++++-
 sys/arm/arm/gic_common.h      |  6 +++
 sys/arm64/arm64/gic_v3_acpi.c |  8 ++--
 3 files changed, 86 insertions(+), 5 deletions(-)

diff --git a/sys/arm/arm/gic_acpi.c b/sys/arm/arm/gic_acpi.c
index b64bfa3fedfd..92955ff54f02 100644
--- a/sys/arm/arm/gic_acpi.c
+++ b/sys/arm/arm/gic_acpi.c
@@ -46,6 +46,9 @@
 
 #include <machine/intr.h>
 
+#include <vm/vm.h>
+#include <vm/pmap.h>
+
 #include <contrib/dev/acpica/include/acpi.h>
 #include <dev/acpica/acpivar.h>
 
@@ -112,6 +115,74 @@ madt_handler(ACPI_SUBTABLE_HEADER *entry, void *arg)
 	}
 }
 
+/* GICv3/v4 distributor frame and its peripheral ID2 register. */
+#define	GICD_V3_SIZE		0x10000
+#define	GICD_V3_PIDR2		0xffe8
+#define	GICD_PIDR2_ARCH(x)	(((x) >> 4) & 0xf)
+
+static void
+gic_acpi_find_redist(ACPI_SUBTABLE_HEADER *entry, void *arg)
+{
+	ACPI_MADT_GENERIC_INTERRUPT *intr;
+	bool *found;
+
+	found = arg;
+	switch (entry->Type) {
+	case ACPI_MADT_TYPE_GENERIC_REDISTRIBUTOR:
+		*found = true;
+		break;
+	case ACPI_MADT_TYPE_GENERIC_INTERRUPT:
+		intr = (ACPI_MADT_GENERIC_INTERRUPT *)entry;
+		if (intr->GicrBaseAddress != 0)
+			*found = true;
+		break;
+	default:
+		break;
+	}
+}
+
+/*
+ * Return the version of the GIC distributor described by the MADT, as an
+ * ACPI_MADT_GIC_VERSION_* value.  Normally the MADT says.  Some hypervisors
+ * (e.g. Apple's Virtualization.framework) leave it unspecified
+ * (ACPI_MADT_GIC_VERSION_NONE); then, if the MADT describes GICv3
+ * redistributors, read the architecture version from GICD_PIDR2, as Linux
+ * does.  Otherwise keep NONE, which the GICv2 driver accepts as before; a
+ * GICv2 distributor is never read beyond its 4 KiB frame.  Both the GICv2 and
+ * the GICv3 ACPI drivers use this so that only one of them claims the
+ * distributor.
+ */
+u_int
+gic_acpi_dist_version(ACPI_TABLE_MADT *madt,
+    ACPI_MADT_GENERIC_DISTRIBUTOR *dist)
+{
+	void *va;
+	uint32_t pidr2;
+	bool redist;
+
+	if (dist->Version != ACPI_MADT_GIC_VERSION_NONE)
+		return (dist->Version);
+
+	redist = false;
+	acpi_walk_subtables(madt + 1, (char *)madt + madt->Header.Length,
+	    gic_acpi_find_redist, &redist);
+	if (!redist)
+		return (ACPI_MADT_GIC_VERSION_NONE);
+
+	va = pmap_mapdev(dist->BaseAddress, GICD_V3_SIZE);
+	pidr2 = *(volatile uint32_t *)((uintptr_t)va + GICD_V3_PIDR2);
+	pmap_unmapdev(va, GICD_V3_SIZE);
+
+	switch (GICD_PIDR2_ARCH(pidr2)) {
+	case 3:
+		return (ACPI_MADT_GIC_VERSION_V3);
+	case 4:
+		return (ACPI_MADT_GIC_VERSION_V4);
+	default:
+		return (ACPI_MADT_GIC_VERSION_NONE);
+	}
+}
+
 static void
 gic_acpi_identify(driver_t *driver, device_t parent)
 {
@@ -120,6 +191,7 @@ gic_acpi_identify(driver_t *driver, device_t parent)
 	ACPI_TABLE_MADT *madt;
 	vm_paddr_t physaddr;
 	device_t dev;
+	u_int version;
 	int i;
 
 	physaddr = acpi_find_table(ACPI_SIG_MADT);
@@ -143,7 +215,8 @@ gic_acpi_identify(driver_t *driver, device_t parent)
 		return;
 
 	/* Check the version of the GIC we have */
-	switch (madt_data.dist->Version) {
+	version = gic_acpi_dist_version(madt, madt_data.dist);
+	switch (version) {
 	case ACPI_MADT_GIC_VERSION_NONE:
 	case ACPI_MADT_GIC_VERSION_V1:
 	case ACPI_MADT_GIC_VERSION_V2:
@@ -181,7 +254,7 @@ gic_acpi_identify(driver_t *driver, device_t parent)
 	BUS_SET_RESOURCE(parent, dev, SYS_RES_MEMORY, 1,
 	    intr->BaseAddress, 4 * 1024);
 
-	acpi_set_private(dev, (void *)(uintptr_t)madt_data.dist->Version);
+	acpi_set_private(dev, (void *)(uintptr_t)version);
 out:
 	acpi_unmap_table(madt);
 }
diff --git a/sys/arm/arm/gic_common.h b/sys/arm/arm/gic_common.h
index d2f422ab6536..ee3529941fd8 100644
--- a/sys/arm/arm/gic_common.h
+++ b/sys/arm/arm/gic_common.h
@@ -110,4 +110,10 @@ __BUS_ACCESSOR(gic, support_lpis, GIC, SUPPORT_LPIS, bool);
 #define GICD_SGIR		0x0F00				/* v1 ICDSGIR */
 #define	 GICD_SGI_TARGET_SHIFT	16
 
+struct acpi_table_madt;
+struct acpi_madt_generic_distributor;
+
+u_int	gic_acpi_dist_version(struct acpi_table_madt *,
+	    struct acpi_madt_generic_distributor *);
+
 #endif /* _GIC_COMMON_H_ */
diff --git a/sys/arm64/arm64/gic_v3_acpi.c b/sys/arm64/arm64/gic_v3_acpi.c
index 88fd0394c548..cabf9401f37c 100644
--- a/sys/arm64/arm64/gic_v3_acpi.c
+++ b/sys/arm64/arm64/gic_v3_acpi.c
@@ -171,6 +171,7 @@ gic_v3_acpi_identify(driver_t *driver, device_t parent)
 	vm_paddr_t physaddr;
 	uintptr_t private;
 	device_t dev;
+	u_int version;
 
 	physaddr = acpi_find_table(ACPI_SIG_MADT);
 	if (physaddr == 0)
@@ -194,8 +195,9 @@ gic_v3_acpi_identify(driver_t *driver, device_t parent)
 		goto out;
 	}
 
-	/* Check the GIC version is supported by thiss driver */
-	switch(madt_data.dist->Version) {
+	/* Check the GIC version is supported by this driver */
+	version = gic_acpi_dist_version(madt, madt_data.dist);
+	switch (version) {
 	case ACPI_MADT_GIC_VERSION_V3:
 	case ACPI_MADT_GIC_VERSION_V4:
 		break;
@@ -229,7 +231,7 @@ gic_v3_acpi_identify(driver_t *driver, device_t parent)
 		    rdist_map, &madt_data);
 	}
 
-	private = madt_data.dist->Version;
+	private = version;
 	/* Flag that the VGIC is in use */
 	if (madt_data.have_vgic)
 		private |= GICV3_PRIV_VGIC;
-- 
2.39.3 (Apple Git-146)

